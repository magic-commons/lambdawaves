dist/
# `npx wrangler dev` (docs/release/DEPLOY.md step 6) creates .wrangler/{cache,state,tmp} in the repository root.
.wrangler/

# tools/gate/server.py generates a self-signed certificate pair here on first run; a private key never enters the repository.
.certs/

# Local credentials and environment overrides must never enter a checkpoint.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
__pycache__/
# The platform shells' build output.
tools/platform/electron/out/
# Store trailer and screenshot raw material (screen recordings), kept beside the repository, never in it.
LANDING PAGE VIDEOS/

# The development link to the molecule volumes (gigabytes of data, never in git).
lab/volumes


# Audio tracks the conductor uses (served by the gate, never in git: docs/conductor/SCORE.md).
/media/

# The research record is archived (tag research-archive-2026-10-30); research/ is a local folder for the tools' shots and scores.
/research/
