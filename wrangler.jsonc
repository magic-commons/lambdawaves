// wrangler.jsonc — λWAVES Alpha on Cloudflare Workers + Static Assets.
//
// This is the OTHER half of the deploy; `node tools/build-deploy.mjs` is the first half and its §V6
// checks this file on every run, so the two cannot drift. Read DEPLOY.md before changing anything here.
//
// ASSETS-ONLY, DELIBERATELY. There is no "main", so there is no Worker script: Cloudflare serves the
// static directory and nothing runs on the server. The dossier's rule is "static application first,
// Worker code only when needed" (§10), and λWAVES needs nothing — every expensive thing it does happens
// on the visitor's GPU (§9, §20). Adding a "main" later is a real decision, not a tidy-up: Cloudflare's
// docs are explicit that `_headers` rules do NOT apply to responses generated by Worker code, so the
// MIME types and cache policy in dist/_headers would have to be re-attached inside the script. The build
// prints a NOTE if this file ever grows a "main", for exactly that reason.
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Becomes the staging hostname: lambdawaves.<account>.workers.dev (dossier §1, §23 stage B).
  // ASCII, lowercase, hyphens only — it is a DNS label. λWAVES is the display name and lives in
  // <title>, the manifest and the mark; it does not belong in a hostname (§3).
  "name": "lambdawaves",

  // Pin the runtime's behaviour. Bump this deliberately, when you have a reason and can retest —
  // never automatically, and never just because time passed.
  "compatibility_date": "2026-09-05",

  // WAVE 68 · RETIRE THE STAGING ORIGIN, and this is the same hazard the whole OWN_ORIGIN argument is
  // built around, one level up. With no key here the default is TRUE, and attaching a custom domain does
  // NOT turn it off — so after DEPLOY.md step 10 there would be TWO live origins, each with its own
  // ROOT-SCOPED, permanently-installed service worker, its own localStorage, and (because the manifest
  // has no `id` and falls back to `start_url`, which is origin-scoped) ITS OWN INSTALLED PWA IDENTITY.
  // That is a worker you cannot purge from a server, on an address you stopped using: the exact thing
  // sw.js's One Law spends a page avoiding, sitting on a hostname nobody is looking at.
  //
  // THE ORDER MATTERS AND IT IS THE ONE THING TO GET RIGHT HERE: this is `false` from the first deploy,
  // so no staging origin is ever created and nothing is ever installed from one. The workers.dev smoke
  // test in DEPLOY.md step 9 therefore needs this flipped to `true` for that one deploy and back to
  // `false` before step 10 — and anyone who does that must know that localStorage is per-origin, so
  // EVERYTHING A TESTER SAVES ON THE STAGING URL — settings, notebook, projects — is stranded there.
  // The alternative, and the better one for an alpha with a handful of testers: attach the custom domain
  // first and smoke-test at the address that ships.
  "workers_dev": false,

  // THE ADDRESS (2026-09-11). A custom-domain route: `wrangler deploy` attaches lambdawaves.magic-commons.com to
  // this Worker and writes the DNS record in the zone, so the deploy and the address are one act, repeatable
  // from a clean machine — DEPLOY.md step 10 no longer needs the dashboard. The zone must be on this account.
  "routes": [{ "pattern": "lambdawaves.magic-commons.com", "custom_domain": true }],

  "assets": {
    // What `node tools/build-deploy.mjs` writes. NOT "lab/": the build is what adds LICENSE, NOTICE,
    // REPORT.md, CHANGELOG.md, robots.txt, _headers and _redirects, drops the ungated smoke.html bench,
    // and proves the result. Pointing this at lab/ would ship an unverified tree missing all of that.
    // (The dossier's §7 sketch says "public/"; we keep the repo's existing lab/ and let the build
    // produce the deployable directory — §7 itself asks to preserve a rational structure and avoid
    // migration churn. DEPLOY.md records that as a deliberate difference.)
    "directory": "./dist",

    // "none", NOT the dossier's illustrative "auto-trailing-slash" — and this one was MEASURED, against
    // wrangler 4.129.0 serving this exact dist/, not reasoned about:
    //
    //   html_handling            GET /            GET /index.html?__rev=x
    //   auto-trailing-slash      200              307 → /?__rev=x
    //   drop-trailing-slash      200              307 → /?__rev=x
    //   none                     404              200
    //   none + the _redirects rewrite below       200              200
    //
    // Why the 307 matters: sw.js §3 precaches './index.html' by fetching it with a ?__rev=<hash> buster
    // and storing the result under the CLEAN url. Under any trailing-slash mode that fetch is redirected,
    // so the stored Response carries redirected = true — and sw.js §5 hands exactly that response to
    // event.respondWith() for every NAVIGATION. A navigation request's redirect mode is "manual", and
    // respondWith() rejects a redirected response for such a request ("The response is a redirected
    // response, but the request was not"). The app would install fine, run fine on the first visit, and
    // then fail to open from the second launch onward — the worst kind of bug to find in production.
    //
    // "none" alone would make "/" a 404, so the build writes a _redirects line that REWRITES "/" to
    // "/index.html" with status 200. A 200 rule is a rewrite, not a redirect: no Location, no hop, and
    // nothing for the service worker to choke on. Both URLs return 200 and neither is redirected.
    // The dossier says to treat its config as "a starting configuration rather than immutable doctrine"
    // and to use the supported equivalent that preserves the architecture (§10). This is that.
    "html_handling": "none",

    // NOT "single-page-application". λWAVES has no path routing at all: state travels in the URL
    // fragment (statelink.js) and the only query read at boot is location.search. An SPA fallback would
    // turn a mistyped asset URL into a 200 of HTML that fails later and more confusingly than a 404.
    // With no 404.html in dist/, unknown paths get Cloudflare's plain 404, which is the honest answer.
    "not_found_handling": "404-page"
  }

  // The custom hostname (lambdawaves.magic-commons.com) is attached in the Cloudflare dashboard once the
  // workers.dev deployment has been smoke-tested — dossier §23 stages B then C, and DEPLOY.md step 10.
}
