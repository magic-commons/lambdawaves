// depot_build_linux.vdf — the Linux x64 depot. NOT READY TO SHIP: Electron's chrome-sandbox needs root:4755 (or an AppArmor
// profile) on Ubuntu 24.04+, and a Steam install cannot provide either. Upload only after the M3 "sudo-free sandbox" answer.
"DepotBuild"
{
	"DepotID" "<DEPOTID_LINUX>"
	"ContentRoot" "/home/joshua-hosain/Documents/LAMBDAWAVES/shells/electron/out/lambdawaves-desktop-linux-x64/"
	"FileMapping"
	{
		"LocalPath" "*"	// lambdawaves-desktop (the executable), chrome-sandbox, resources/ (app.asar + dist/), LICENSE, LICENSES.chromium.html, the .so files
		"DepotPath" "."
		"Recursive" "1"
	}
}
