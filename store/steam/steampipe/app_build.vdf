// app_build.vdf — λWAVES SteamPipe app build (template). Format: partner.steamgames.com/doc/sdk/uploading, read 2026-09-24.
// Replace <APPID>, <DEPOTID_WIN>, <DEPOTID_LINUX> with the numbers Steamworks gives the app and its depots.
// Relative paths below resolve from THIS file's folder; if steamcmd says it cannot find content, make them absolute.
"AppBuild"
{
	"AppID" "<APPID>"
	"Desc" "lambdawaves <version> <git tag> <git sha>"	// shown in Steamworks' build list; copy from shells/electron/out/build-identity.json
	"Preview" "0"	// "1" = scan and report only, upload nothing: do that first
	"SetLive" ""	// leave empty; set the build live on a branch by hand in Steamworks
	"BuildOutput" "./output/"	// logs and the chunk cache; gitignored by store/.gitignore
	"Depots"
	{
		"<DEPOTID_WIN>" "depot_build_windows.vdf"
		"<DEPOTID_LINUX>" "depot_build_linux.vdf"	// delete this line until the Linux sandbox question is solved (COPY.md, system requirements)
	}
}
